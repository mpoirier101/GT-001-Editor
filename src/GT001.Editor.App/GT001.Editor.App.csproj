<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="..\..\GTe.ico" Link="GTe.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <ProjectReference Include="..\GT001.Editor.Core\GT001.Editor.Core.csproj" />
    <ProjectReference Include="..\GT001.Editor.Midi\GT001.Editor.Midi.csproj" />
    <ProjectReference Include="..\GT001.Editor.Protocol\GT001.Editor.Protocol.csproj" />
    <ProjectReference Include="..\GT001.Editor.Storage\GT001.Editor.Storage.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <ApplicationIcon>..\..\GTe.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <Target Name="CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResourceFiles Include="$(TargetDir)App.xbf" />
      <_WinUIResourceFiles Include="$(TargetDir)MainWindow.xbf" />
      <_WinUIResourceFiles Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WinUIResourceFiles)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('%(_WinUIResourceFiles.Identity)')" />
  </Target>

  <Target Name="TrimWinUILocalizedResources" AfterTargets="Publish">
    <ItemGroup>
      <_WinUILocalizedResourceFiles
        Include="$(PublishDir)*\Microsoft.ui.xaml.dll.mui;$(PublishDir)*\Microsoft.UI.Xaml.Phone.dll.mui"
        Exclude="$(PublishDir)en-us\**" />
      <_WinUILocalizedResourceDirectories Include="@(_WinUILocalizedResourceFiles->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Delete Files="@(_WinUILocalizedResourceFiles)" />
    <RemoveDir Directories="@(_WinUILocalizedResourceDirectories)" />
  </Target>

</Project>
